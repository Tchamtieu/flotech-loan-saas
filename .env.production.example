# ============================================================================
# FLOTECH DIGITAL — MULTI-TENANT LOAN MANAGEMENT SAAS
# PRODUCTION ENVIRONMENT TEMPLATE (Cloud Run + Cloud SQL + Cloudflare Pages)
# NEVER COMMIT REAL SECRETS OR PRIVATE KEYS TO VERSION CONTROL
# ============================================================================

# --- Backend (Google Cloud Run: https://api.loans.flotechdigital.com) ---
NODE_ENV=production
PORT=8080
CORS_ALLOWED_ORIGINS=https://loans.flotechdigital.com

# PostgreSQL Single Source of Truth (Google Cloud SQL Unix Socket or Private IP)
DATABASE_URL=postgresql://flotech_app_user:REPLACE_WITH_SECRET_MANAGER_PASSWORD@localhost/flotech_loan_saas?host=/cloudsql/flotech-digital-prod:us-central1:flotech-loans-pg15
DB_POOL_MAX=25
DB_IDLE_TIMEOUT_MS=30000

# Firebase Admin SDK & App Check Verification
FIREBASE_PROJECT_ID=flotech-loans-prod
ENFORCE_FIREBASE_APP_CHECK=true

# --- Frontend Build Variables (Cloudflare Pages: https://loans.flotechdigital.com) ---
VITE_API_BASE_URL=https://api.loans.flotechdigital.com/api/v1
VITE_FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=flotech-loans-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=flotech-loans-prod
VITE_FIREBASE_STORAGE_BUCKET=flotech-loans-prod.firebasestorage.app
VITE_FIREBASE_APP_ID=REPLACE_WITH_FIREBASE_APP_ID
VITE_FIREBASE_RECAPTCHA_SITE_KEY=REPLACE_WITH_RECAPTCHA_ENTERPRISE_SITE_KEY
