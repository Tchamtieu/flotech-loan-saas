# Server Configuration
NODE_ENV=development
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL Database (Single Source of Truth)
# Local development default; Google Cloud SQL via Unix socket or private IP in production
DATABASE_URL=postgresql://flotech_app:replace_with_local_password@localhost:5432/flotech_loan_saas
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000

# Firebase Admin SDK & App Check
FIREBASE_PROJECT_ID=flotech-loan-saas-dev
FIREBASE_STORAGE_BUCKET=flotech-loan-saas-dev.appspot.com
ENFORCE_FIREBASE_APP_CHECK=true
# In local development without a live Firebase project, set GOOGLE_APPLICATION_CREDENTIALS to a service account key path
# In Google Cloud Run, Application Default Credentials (ADC) are used automatically without key files.
